{
  "manifest_version": 3,
  "name": "Unforged",
  "version": "0.0.0",
  "description": "Blocks dapp code that independent builders have not reproduced from source.",
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unforged@unforged.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "storage",
    "alarms",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}

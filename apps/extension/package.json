{
  "name": "@unforged/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/check-no-fixture.mjs",
    "test": "vitest run",
    "fixture:snapshot": "node scripts/make-fixture-snapshot.mjs",
    "build:fixture": "UNFORGED_FIXTURE=1 pnpm build"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "viem": "^2.57.16",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@unforged/core": "workspace:*",
    "@unforged/registry": "workspace:*"
  }
}
